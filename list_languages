import os
import pandas as pd

class ProcessMemoqTerminology:
    def __init__(self, file_paths):
        self.file_paths = file_paths
        self.terminology_merged = None
    def check_file(self):
        self.file_paths = os.path.splitext(self.file_paths)
        if self.file_paths[-1] != ".xlsx" and self.file_paths[-1] != ".csv":
            print("Error: File needs to be a .xlsx or .csv")
    def import_xlsx(self):
        self.files_split = os.path.splitext(self.file_paths)
        if self.files_split[-1] == ".xlsx":
            return pd.read_excel(self.file_paths)
    def import_csv(self):
        self.files_split = os.path.splitext(self.file_paths)
        if self.files_split[-1] == ".csv":
            return pd.read_csv(self.file_paths)
    def merge_terminology(self):
        self.files_split = os.path.splitext(self.file_paths)
        if self.files_split[-1] == ".xlsx":
            item = self.import_xlsx()
        elif self.files_split[-1] == ".csv":
            item = self.import_csv()
        self.terminology_merged = pd.concat([item])
    def export_merged_terminology_as_xlsx(self):
        if self.terminology_merged() is None:
            self.merge_terminology()
        self.terminology_merged.to_excel("sample_files/tb_merged.xlsx", index=False)

